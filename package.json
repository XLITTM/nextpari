{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "staff:onboarding:test": "tsx --tsconfig tsconfig.server.json --test server/staff/staffOnboarding.test.ts server/staff/vercelAdapter.test.ts server/staff/esmImportSmoke.test.ts",
    "owner:auth:test": "tsx --tsconfig tsconfig.server.json --test src/owner/auth/ownerAuth.test.ts server/staff/ownerAuthGateway.test.ts src/security/auth/securityAuth.test.ts server/staff/securityAuthGateway.test.ts",
    "owner:control:test": "tsx --tsconfig tsconfig.server.json --test server/owner/ownerControl.test.ts server/owner/ownerPlayerDebit.test.ts server/owner/ownerDashboardAuth.test.ts server/owner/ownerListCashiers.test.ts server/staff/staffHierarchy.test.ts src/owner/securityReview.test.ts server/owner/securitySportsInvestigation.test.ts server/owner/securityStaffPortal.test.ts server/security/securityControl.test.ts server/player/playerWinPattern.test.ts",
    "manager:auth:test": "tsx --tsconfig tsconfig.server.json --test src/manager/auth/managerAuth.test.ts server/staff/managerAuthGateway.test.ts",
    "cashier:auth:test": "tsx --tsconfig tsconfig.server.json --test src/cashier/auth/cashierAuth.test.ts server/staff/cashierAuthGateway.test.ts server/staff/staffBindingContext.test.ts",
    "cashier:control:test": "tsx --tsconfig tsconfig.server.json --test server/cashier/cashierControl.test.ts src/cashier/services.test.ts server/cashier/cashierPlayerFinance.test.ts server/cashier/cashierDepositReversal.test.ts server/staff/staffHierarchy.test.ts",
    "owner:player-debit:test": "tsx --tsconfig tsconfig.server.json --test server/owner/ownerPlayerDebit.test.ts",
    "cashier:reversal:test": "tsx --tsconfig tsconfig.server.json --test server/cashier/cashierDepositReversal.test.ts",
    "manager:control:test": "tsx --tsconfig tsconfig.server.json --test server/manager/managerControl.test.ts server/manager/managerFinance.test.ts server/manager/managerRpcSecurity.test.ts server/owner/ownerDashboardAuth.test.ts server/staff/staffHierarchy.test.ts",
    "player:auth:test": "tsx --tsconfig tsconfig.server.json --env-file ./src/lib/playerAuth.test.env --test src/lib/playerAuth.security.test.ts src/lib/authUiFlow.test.ts server/player/playerAuth.test.ts server/player/playerAuth.multi.test.ts server/player/playerChangePassword.test.ts server/auth/oneClickPassword.test.ts server/player/playerSecurity.test.ts server/player/playerPasswordRecovery.test.ts src/lib/playerPasswordRecovery.test.ts",
    "player:security:test": "tsx --tsconfig tsconfig.server.json --env-file ./src/lib/playerAuth.test.env --test server/player/playerSecurity.test.ts server/player/playerSecurityRestriction.test.ts server/owner/securitySportsInvestigation.test.ts server/player/playerWinPattern.test.ts server/player/playerManualVerification.test.ts",
    "player:change-password:test": "tsx --tsconfig tsconfig.server.json --env-file ./src/lib/playerAuth.test.env --test server/player/playerChangePassword.test.ts src/lib/playerChangePassword.test.ts",
    "player:password-recovery:test": "tsx --tsconfig tsconfig.server.json --env-file ./src/lib/playerAuth.test.env --test server/player/playerPasswordRecovery.test.ts src/lib/playerPasswordRecovery.test.ts src/lib/authUiFlow.test.ts",
    "player:sequential-id:test": "tsx --tsconfig tsconfig.server.json --test server/player/playerSequentialId.test.ts",
    "player:email-verification:test": "tsx --tsconfig tsconfig.server.json --env-file ./src/lib/playerAuth.test.env --test server/player/playerEmailVerification.test.ts",
    "player:manual-verification:test": "tsx --tsconfig tsconfig.server.json --env-file ./src/lib/playerAuth.test.env --test server/player/playerManualVerification.test.ts src/lib/playerVerification.test.ts src/owner/securityReview.test.ts",
    "player:personal-data:test": "tsx --tsconfig tsconfig.server.json --env-file ./src/lib/playerAuth.test.env --test server/player/playerPersonalData.test.ts src/lib/playerPersonalData.test.ts",
    "player:multi-currency:test": "tsx --tsconfig tsconfig.server.json --env-file ./src/lib/playerAuth.test.env --test server/player/playerMultiCurrency.test.ts",
    "operational:multi-currency:test": "tsx --tsconfig tsconfig.server.json --test server/owner/operationalMultiCurrency.test.ts",
    "currency:limits:test": "tsx --tsconfig tsconfig.server.json --test server/owner/currencyLimits.test.ts",
    "player:withdrawals:test": "tsx --tsconfig tsconfig.server.json --test server/player/playerWithdrawals.test.ts",
    "provider:settlement:test": "tsx --tsconfig tsconfig.server.json --test server/providerAccounting/providerAccounting.test.ts server/providerAccounting/providerAccounting.sql.test.ts src/owner/providerSettlementDisplay.test.ts",
    "games:engine:test": "tsx --tsconfig tsconfig.server.json --test server/games/engine.test.ts server/games/report.test.ts server/player/playerGames.test.ts server/games/ui.regression.test.ts server/games/crystal.layout.test.ts server/games/blackjack.cutover.test.ts server/games/dice.cutover.test.ts",
    "games:rtp:test": "tsx --tsconfig tsconfig.server.json --test server/games/rtp.test.ts",
    "games:math:test": "tsx --tsconfig tsconfig.server.json --test server/owner/ownedGamesMath.test.ts server/games/rtp.test.ts server/games/dice.cutover.test.ts server/games/blackjack.cutover.test.ts",
    "betconstruct:iframe:test": "tsx --tsconfig tsconfig.server.json --test server/betconstruct/betconstruct.iframe.test.ts",
    "betconstruct:wallet:test": "tsx --tsconfig tsconfig.server.json --test server/betconstruct/betconstruct.wallet.test.ts",
    "start": "tsx --tsconfig tsconfig.server.json scripts/run-lsports-worker.ts",
    "sports:acceptance:test": "tsx --tsconfig tsconfig.server.json --test server/sports/acceptanceIntegrity.test.ts",
    "lsports:test": "tsx --tsconfig tsconfig.server.json --test server/lsports/lsports.test.ts server/lsports/state/state.test.ts server/lsports/adapter/adapter.test.ts server/lsports/bridge/bridge.test.ts server/lsports/bridge/startup.test.ts server/lsports/prematch/prematch.test.ts server/lsports/sdk/sdk.test.ts server/sports/sports.test.ts server/sports/quoteProviderRegistry.test.ts server/sports/quote.provider-neutral.test.ts server/sports/settlement.provider-neutral.test.ts server/sports/settlement.sql.provider-aware.test.ts server/sports/acceptanceIntegrity.test.ts server/player/sportsPlace.test.ts src/lib/lsportsFeed.test.ts src/lib/lsportsShadow.test.ts src/lib/sportsPlaceRequest.test.ts src/lib/sportsOddGuard.test.ts src/lib/oddPressController.test.ts src/lib/sportsOddIdentity.test.ts src/lib/betSlipSubmitLock.test.ts src/lib/sportsOddsChanged.test.ts",
    "lsports:distribution:status:prematch": "tsx --tsconfig tsconfig.server.json --env-file=.env.lsports.local scripts/run-lsports-distribution-status.ts prematch",
    "lsports:distribution:start:prematch": "tsx --tsconfig tsconfig.server.json --env-file=.env.lsports.local scripts/run-lsports-distribution-start.ts prematch",
    "lsports:worker": "tsx --tsconfig tsconfig.server.json --env-file=.env.lsports.local scripts/run-lsports-worker.ts",
    "lsports:shadow:inplay": "tsx --tsconfig tsconfig.server.json --env-file=.env.lsports.local scripts/run-lsports-shadow.ts",
    "lsports:probe:inplay": "tsx --tsconfig tsconfig.server.json --env-file=.env.lsports.local scripts/run-lsports-probe.ts inplay",
    "lsports:observe:inplay": "tsx --tsconfig tsconfig.server.json --env-file=.env.lsports.local scripts/run-lsports-observe.ts inplay",
    "lsports:capture:types:inplay": "tsx --tsconfig tsconfig.server.json --env-file=.env.lsports.local scripts/run-lsports-type-capture.ts inplay",
    "lsports:probe:prematch": "tsx --tsconfig tsconfig.server.json --env-file=.env.lsports.local scripts/run-lsports-probe.ts prematch",
    "lsports:probe:both": "tsx --tsconfig tsconfig.server.json --env-file=.env.lsports.local scripts/run-lsports-probe.ts both",
    "lsports:distribution:status:inplay": "tsx --tsconfig tsconfig.server.json --env-file=.env.lsports.local scripts/run-lsports-distribution-status.ts inplay",
    "lsports:distribution:start:inplay": "tsx --tsconfig tsconfig.server.json --env-file=.env.lsports.local scripts/run-lsports-distribution-start.ts inplay",
    "lsports:snapshot:inplay:football": "tsx --tsconfig tsconfig.server.json --env-file=.env.lsports.local scripts/run-lsports-snapshot.ts inplay",
    "lsports:snapshot:inplay:scores-markets": "tsx --tsconfig tsconfig.server.json --env-file=.env.lsports.local scripts/run-lsports-snapshot-scores-markets.ts inplay",
    "lsports:sdk:order": "tsx --tsconfig tsconfig.server.json --env-file=.env.lsports.local scripts/run-lsports-sdk-order.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@sentry/react": "^10.75.0",
    "@supabase/supabase-js": "^2.112.3",
    "@vercel/functions": "^3.9.7",
    "amqplib": "^2.0.1",
    "lucide-react": "^0.446.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "trade360-nodejs-sdk": "^3.10.9",
    "tsx": "^4.23.12",
    "ws": "^8.21.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2"
  }
}
