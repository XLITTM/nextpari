# Worker secrets — set in the host dashboard. Do not commit values.
LSPORTS_RMQ_USERNAME=
LSPORTS_RMQ_PASSWORD=
LSPORTS_INPLAY_HOST=stm-inplay.lsports.eu
LSPORTS_INPLAY_PORT=5672
LSPORTS_INPLAY_VHOST=StmInPlay
LSPORTS_INPLAY_PACKAGE_ID=4351
LSPORTS_PREMATCH_HOST=stm-prematch.lsports.eu
LSPORTS_PREMATCH_PORT=5672
LSPORTS_PREMATCH_VHOST=StmPreMatch
LSPORTS_PREMATCH_PACKAGE_ID=4352
LSPORTS_RMQ_HEARTBEAT=30
LSPORTS_WORKER_MODE=remote
LSPORTS_HTTP_HOST=0.0.0.0
LSPORTS_ALLOWED_ORIGINS=https://nextpari.net,https://www.nextpari.net
LSPORTS_ALLOW_VERCEL_PREVIEWS=1
# Keep production on direct RMQ until SDK shadow parity is proven.
LSPORTS_TRANSPORT=direct
# In-process SDK classification only. Do not start a second RMQ consumer on _4351_/_4352_.
LSPORTS_SDK_SHADOW=1
# Optional Type 35 → Nextpari wallet webhook. Does not affect RMQ health.
# LSPORTS_SETTLEMENT_WEBHOOK_URL=https://nextpari.net/api/internal/sports/settle
# LSPORTS_SETTLEMENT_SECRET=
# PORT is provided by Railway/Render. Do not hardcode it.
