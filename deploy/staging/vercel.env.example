# Vercel staging project only. Same names and empty secrets as .env.staging.example.
# Vercel labels this project's main branch VERCEL_ENV=production. NEXTPARI_ENV=staging is what isolates it.
# Set the public origin in the dashboard to an https host whose name contains "staging".
# Do not use nextpari.net or any host under it. Leave cookies host-only (NEXTPARI_COOKIE_DOMAIN empty).
# Do not paste production Supabase keys, payment keys, BetConstruct keys, or LSports credentials.

NEXTPARI_ENV=staging
NEXTPARI_SYNTHETIC_USERS_ONLY=true
NEXTPARI_REAL_MONEY_ENABLED=false
NEXTPARI_PAYMENTS_ENABLED=false
NEXTPARI_WALLET_MODE=synthetic
NEXTPARI_ALLOW_PRODUCTION_PLAYER_IMPORT=false
NEXTPARI_STAGING_CREDENTIALS_ARE_DISTINCT=true
NEXTPARI_PLAYER_EMAIL_DOMAIN=staging.nextpari.test
NEXTPARI_COOKIE_DOMAIN=
NEXTPARI_PUBLIC_ORIGIN=
NEXTPARI_PRODUCTION_SUPABASE_PROJECT_REF=
NEXTPARI_STAGING_SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
PLAYER_EMAIL_OTP_PEPPER=
PLAYER_SECURITY_SIGNAL_PEPPER=
RESEND_API_KEY=
PLAYER_EMAIL_FROM=
DATABASE_URL=
SUPABASE_DB_URL=
POSTGRES_URL=
DIRECT_URL=
PRODUCTION_DATABASE_URL=
BETCONSTRUCT_ENABLED=0
BETCONSTRUCT_OPERATOR_ID=
BETCONSTRUCT_SPORTS_SHARED_KEY=
BETCONSTRUCT_SPORTS_ALLOWED_IPS=
BETCONSTRUCT_CASINO_SHARED_KEY=
BETCONSTRUCT_CASINO_ALLOWED_IPS=
BETCONSTRUCT_SPORTSBOOK_IFRAME_ORIGIN=
BETCONSTRUCT_CASINO_IFRAME_ORIGIN=
CANONICAL_SPORTS_BET_ENABLED=0
LSPORTS_DISPLAY_FEED=0
VITE_LSPORTS_DISPLAY_FEED=0
LSPORTS_RMQ_USERNAME=
LSPORTS_RMQ_PASSWORD=
LSPORTS_INPLAY_USERNAME=
LSPORTS_INPLAY_PASSWORD=
LSPORTS_PREMATCH_USERNAME=
LSPORTS_PREMATCH_PASSWORD=
LSPORTS_INPLAY_PACKAGE_ID=
LSPORTS_PREMATCH_PACKAGE_ID=
LSPORTS_FEED_BASE_URL=
VITE_LSPORTS_FEED_BASE_URL=
LSPORTS_ALLOWED_ORIGINS=
LSPORTS_SETTLEMENT_SECRET=
LSPORTS_SETTLEMENT_WEBHOOK_URL=
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=staging
SENTRY_DSN=
