{
  "git": {
    "deploymentEnabled": { "cursor/betsapi-readonly-feed-b001": false, "work/casino-demo-softaggregator-w001": false }
  },
  "functions": {
    "api/player/sports/football-feed.ts": {
      "maxDuration": 60
    },
    "api/internal/sports/betsapi-settle.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/internal/sports/betsapi-settle",
      "schedule": "*/5 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/betsapi/:path*",
      "destination": "/api/betsapi/:path*"
    },
    {
      "source": "/((?!api/|images/|icons/|favicon\\.svg|manifest\\.json|sw\\.js|apple-touch-icon\\.png|25534\\.png).*)",
      "destination": "/index.html"
    }
  ]
}
