{
  "git": {
    "deploymentEnabled": { "cursor/betsapi-readonly-feed-b001": false, "work/casino-demo-softaggregator-w001": false }
  },
  "functions": {
    "api/player/sports/football-feed.ts": {
      "maxDuration": 60
    },
    "api/internal/sports/betsapi-settle.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/internal/sports/betsapi-settle",
      "schedule": "*/5 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/downloads/(.*)\\.apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"NextPari-0.2.0-debug.apk\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/betsapi/:path*",
      "destination": "/api/betsapi/:path*"
    },
    {
      "source": "/((?!api/|images/|icons/|downloads/|favicon\\.svg|manifest\\.json|sw\\.js|apple-touch-icon\\.png|25534\\.png).*)",
      "destination": "/index.html"
    }
  ]
}
