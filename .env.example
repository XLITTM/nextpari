SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional player support address for verification contact. Leave empty until a real address exists.
PLAYER_SUPPORT_EMAIL=

# Frontend Sentry error monitoring. Leave empty to disable. Never commit a real DSN.
# Configure the real DSN only in Vercel environment variables for Production and Preview.
VITE_SENTRY_DSN=

# Preview verification (not available in production player traffic):
# Open the Preview deployment with ?np_sentry_test=NEXTPARI_SENTRY_TEST
# This reports NEXTPARI_SENTRY_TEST_ERROR to Sentry without crashing the app.

# Source-map upload is a follow-up deployment configuration only.
# Do not put SENTRY_AUTH_TOKEN in this repository, source, tests, logs, or PRs.
# Later CI/Vercel step: @sentry/vite-plugin with org/project, using an auth token
# stored only in Vercel/CI secrets.
