SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional player support address for verification contact. Leave empty until a real address exists.
PLAYER_SUPPORT_EMAIL=

# Frontend Sentry error monitoring. Leave empty to disable. Never commit a real DSN.
# Configure the real DSN only in Vercel environment variables for Production and Preview.
# Browser-only. Server does not fall back to this variable.
VITE_SENTRY_DSN=

# Server-side Sentry DSN for Preview/Production Node/Vercel API monitoring.
# Separate from VITE_SENTRY_DSN. Leave empty to disable. Never commit a real DSN.
SENTRY_DSN=

# Preview-only controlled verification token for POST /api/internal/sentry-test.
# Supply it only in the x-nextpari-sentry-test header. Never put a real token in the repo.
SENTRY_TEST_TOKEN=

# Preview verification (not available in production player traffic):
# Open the Preview deployment with ?np_sentry_test=NEXTPARI_SENTRY_TEST
# This reports NEXTPARI_SENTRY_TEST_ERROR to Sentry without crashing the app.
# Server Preview verification: POST /api/internal/sentry-test with x-nextpari-sentry-test.
# That reports NEXTPARI_SERVER_SENTRY_TEST_ERROR. Production always returns 404.

# Source-map upload is a follow-up deployment configuration only.
# Do not put SENTRY_AUTH_TOKEN in this repository, source, tests, logs, or PRs.
# Later CI/Vercel step: @sentry/vite-plugin with org/project, using an auth token
# stored only in Vercel/CI secrets.

# Server-only BetsAPI read-only football feed. Never put the token in frontend code or VITE_ variables.
# Leave these empty in the repo. Set them only in a local shell or the staging environment.
# BETSAPI_TOKEN=
# BETSAPI_READONLY_PREVIEW=0
# BETSAPI_PREVIEW_KEY=
# Real football betting stays stopped until every line below is set on the server.
# SPORTSBOOK_EMERGENCY_STOP=0
# BETSAPI_SPORTSBOOK_QUOTE=1
# CANONICAL_SPORTS_BET_ENABLED=1
# SPORTSBOOK_AUTHORIZED_PLAYER_IDS=
# SPORTSBOOK_MAX_STAKE=
# NEXTPARI_SPORTS_SETTLE_URL=
# NEXTPARI_SPORTS_SETTLEMENT_SECRET=
