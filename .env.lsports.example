LSPORTS_RMQ_USERNAME=
LSPORTS_RMQ_PASSWORD=
LSPORTS_INPLAY_HOST=stm-inplay.lsports.eu
LSPORTS_INPLAY_PORT=5672
LSPORTS_INPLAY_VHOST=StmInPlay
LSPORTS_INPLAY_PACKAGE_ID=4351
LSPORTS_PREMATCH_HOST=stm-prematch.lsports.eu
LSPORTS_PREMATCH_PORT=5672
LSPORTS_PREMATCH_VHOST=StmPreMatch
LSPORTS_PREMATCH_PACKAGE_ID=4352
LSPORTS_RMQ_HEARTBEAT=30

# Optional flow-specific overrides. If omitted, LSPORTS_RMQ_* is used.
# LSPORTS_INPLAY_USERNAME=
# LSPORTS_INPLAY_PASSWORD=
# LSPORTS_PREMATCH_USERNAME=
# LSPORTS_PREMATCH_PASSWORD=

# Shadow/display-only LSports feed. Not a secret. Default is off (BetsAPI inplay stays).
# LSPORTS_DISPLAY_FEED=1
# LSPORTS_SHADOW_PORT=8787
# For the Vite UI to skip BetsAPI inplay, set VITE_LSPORTS_DISPLAY_FEED=1
# in the app env file (.env.local). Never put LSports usernames or passwords there.

# Remote always-on worker (Railway / Render). Names only — never commit secrets.
# LSPORTS_WORKER_MODE=remote
# PORT=
# LSPORTS_HTTP_HOST=0.0.0.0
# LSPORTS_ALLOWED_ORIGINS=https://nextpari.net,https://www.nextpari.net
# LSPORTS_ALLOW_VERCEL_PREVIEWS=1

# Vercel / nextpari.net frontend (public selectors only, not secrets):
# VITE_LSPORTS_DISPLAY_FEED=1
# VITE_LSPORTS_FEED_BASE_URL=https://YOUR-WORKER-HOST
